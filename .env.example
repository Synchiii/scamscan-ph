# Copy this file to server/.env and set a local MongoDB connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/sentinel_ph
JWT_SECRET=replace-with-a-long-random-secret
# Login sessions expire after 30 minutes (0.5 hours; maximum: 0.5).
SESSION_TTL_HOURS=0.5
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# Optional external URL reputation providers. Keep these keys only on the server.
# VirusTotal Public API is for academic/non-commercial use and is rate-limited.
VIRUSTOTAL_API_KEY=
# Google Web Risk is the supported commercial Google URL reputation service.
GOOGLE_WEB_RISK_API_KEY=

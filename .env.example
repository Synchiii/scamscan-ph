# Copy this file to server/.env and set a local MongoDB connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/sentinel_ph
JWT_SECRET=replace-with-a-long-random-secret
# Login sessions expire after 30 minutes (0.5 hours; maximum: 0.5).
SESSION_TTL_HOURS=0.5
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

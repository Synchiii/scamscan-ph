MONGODB_URI=mongodb://127.0.0.1:27017/sentinel_ph
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-this-with-a-long-random-secret
NODE_ENV=development

# Create the first dashboard administrator with: npm run create-admin
ADMIN_NAME=ScamScan Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-8-plus-characters-1

# Optional for local development, required for verification and password-reset OTP emails in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ScamScan <no-reply@example.com>
